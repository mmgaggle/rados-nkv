# BUGFIX: KV retrieve DW0 torn read (key_idx=0 returned 0)
# nvme-ep.hip: fence + re-read CQE after observing phase flip, before cdw0
######################################################################
### after fix — wavefront retrieve (all 4 correct) ###
KV retrieve OK: key_idx=0 returned value length = 4096 bytes
KV retrieve OK: key_idx=1 returned value length = 4096 bytes
KV retrieve OK: key_idx=2 returned value length = 4096 bytes
KV retrieve OK: key_idx=3 returned value length = 4096 bytes
### serial single-key retrieve (was 0, now correct) ###
KV retrieve OK: returned value length = 4096 bytes

### the patch (git diff) ###
diff --git a/src/endpoints/nvme-ep/nvme-ep.hip b/src/endpoints/nvme-ep/nvme-ep.hip
index 46fef41..dc3187e 100644
--- a/src/endpoints/nvme-ep/nvme-ep.hip
+++ b/src/endpoints/nvme-ep/nvme-ep.hip
@@ -914,6 +914,12 @@ __device__ static void driveEndpointKv(const XioEndpointConfig& config,
       }
       cqe_new = nvme_ep::cqeRead(cqe_entry);
       if (NVME_CQE_STATUS_PHASE(cqe_new.status) == expected_phase) {
+        // Acquire: the phase bit is the CQE last dword, but cqeRead copies
+        // cdw0 first — one read can capture a stale cdw0 (0) with the
+        // freshly-flipped phase. Fence + re-read so DW0 (KV value length)
+        // is coherent before use.
+        __threadfence_system();
+        cqe_new = nvme_ep::cqeRead(cqe_entry);
         break;
       }
       if (++poll_count >= NVME_EP_MAX_POLLS) {
@@ -1148,6 +1154,12 @@ __device__ static void driveEndpointKvWavefront(
           }
           cqe_new = nvme_ep::cqeRead(cqe_entry);
           if (NVME_CQE_STATUS_PHASE(cqe_new.status) == expected_phase) {
+            // Acquire: the phase bit is the CQE last dword, but cqeRead copies
+            // cdw0 first — one read can capture a stale cdw0 (0) with the
+            // freshly-flipped phase. Fence + re-read so DW0 (KV value length)
+            // is coherent before use.
+            __threadfence_system();
+            cqe_new = nvme_ep::cqeRead(cqe_entry);
             break;
           }
           poll_count++;

