#cloud-config
# Template consumed by provisioning/build-image.sh. The @BUILD_ROCM_XIO_B64@
# marker is replaced with base64(provisioning/build-rocm-xio.sh) at seed-build
# time (encoding: b64 below), then the assembled user-data drives a one-shot
# provisioning boot (cloud-init installs packages, writes the script, runs it,
# powers off).
hostname: ceph-gpu
disable_root: true
ssh_pwauth: true
users:
  - name: ubuntu
    plain_text_passwd: 'password'
    lock_passwd: false
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: users, admin, kvm, render, video
    shell: /bin/bash

package_update: true
packages:
  - build-essential
  - cmake
  - ninja-build
  - git
  - pkg-config
  - python3
  - python3-pip
  - libnuma-dev
  - libssl-dev
  - ca-certificates
  - curl
  - gnupg

write_files:
  - path: /usr/local/sbin/build-rocm-xio.sh
    owner: root:root
    permissions: '0755'
    encoding: b64
    content: @BUILD_ROCM_XIO_B64@

runcmd:
  - [ /usr/local/sbin/build-rocm-xio.sh ]

# Power off when provisioning finishes so the one-shot boot in build-image.sh
# returns and the image is left ready for `make vm-run`.
power_state:
  mode: poweroff
  message: provisioning complete
  timeout: 30
  condition: true
