# rados-nkv-client — the `rkv` Rust NVMe-KV CLI as a SEPARATE image (Slice I).
#
# Why separate: rkv pulls in the Rust toolchain (and, with WITH_GPU, ROCm/HIP),
# which would bloat the lean nkv/nkvx datapath image (packaging/container/
# Dockerfile). rkv links SPDK STATICALLY (libspdk_vfio_user/util/log .a + the
# DPDK librte_*.a + isa-l + libvfio-user.a) so the runtime image carries no SPDK
# shared libs — only the distro shared libs the binary dynamically needs.
#
# OUT-OF-TREE (Slice I): rkv builds against the UNMODIFIED pre-built SPDK base
# (commit X). Its build.rs (clients/rkv/build.rs) locates SPDK via
# NKVX_SPDK_BUILD=<spdk>/build and reads, under <spdk>/.. :
#   include/, build/lib/libspdk_*.a, build/libvfio-user/usr/local/{include,lib},
#   dpdk/build/lib/librte_*.a (STATIC), isa-l/.libs, isa-l-crypto/.libs,
#   isalbuild/, isalcryptobuild/.
# The base was built --with-shared with an EXTERNAL DPDK, so its own
# spdk/dpdk/build/lib has no static archives; build-client.sh stages the SPDK
# base at $SPDK_BASE_DIR and the static DPDK archives into its dpdk/build/lib so
# build.rs finds them.
#
#   packaging/container/build-client.sh
#     -> quay.io/mmgaggle/rados-nkv-client:devel

ARG FEDORA_VERSION=44
ARG WITH_GPU=0
# AMD GPU offload target for the gpu-native HIP kernel (WITH_GPU=1). Default
# gfx1151 (Strix Halo); override for other GPUs.
ARG GPU_ARCH=gfx1151
# The SPDK base tree's in-image absolute path (== the host path its RUNPATHs
# encode); build-client.sh stages spdk-base here and the static DPDK under it.
ARG SPDK_BASE_DIR=/home/kyle/src/rados-nkv-wt/slice-a/spdk

# ---------------------------------------------------------------------------
FROM fedora:${FEDORA_VERSION} AS rkv-builder
ARG WITH_GPU
ARG GPU_ARCH
ARG SPDK_BASE_DIR

# Rust toolchain + the link-time devel packages whose .so symlinks the binary's
# static SPDK/DPDK link needs (build.rs links -libverbs -lrdmacm -llz4 -ljson-c
# -lssl -lcrypto -lfuse3 -lkeyutils -luuid -lnuma, plus CUnit/libfdt pulled by
# the static SPDK/DPDK archives).
RUN dnf install -y \
        cargo rust gcc gcc-c++ make findutils \
        rdma-core-devel lz4-devel json-c-devel openssl-devel \
        fuse3-devel keyutils-libs-devel libuuid-devel numactl-devel \
        CUnit-devel libfdt \
    && dnf clean all

# WITH_GPU=1 additionally links HIP in-process via the `gpu-native` feature
# (needs hipcc + libamdhip64). The base image has NO ROCm, so this path requires
# a base that carries it (or extend here).
RUN if [ "${WITH_GPU}" = "1" ]; then \
        dnf install -y hipcc rocm-hip-devel rocm-runtime || \
        dnf install -y rocm-hip rocm-runtime hipcc || \
        (echo "ERROR: WITH_GPU=1 but ROCm/hipcc packages unavailable." >&2; exit 1); \
        dnf clean all; \
    fi

# The pre-built SPDK base (with the static DPDK archives staged into
# dpdk/build/lib by build-client.sh) at its original absolute path.
COPY spdk-base ${SPDK_BASE_DIR}

# The rkv crate + the vfu_host header it #includes (clients/nvme-kv/kv/vfu_host/
# nkv_vfu.h) staged by build-client.sh.
COPY clients /src/clients
WORKDIR /src/clients/rkv

# build.rs locates the prebuilt SPDK via NKVX_SPDK_BUILD; root = its parent.
ENV NKVX_SPDK_BUILD=${SPDK_BASE_DIR}/build

# Build the binary. CPU is the default (ROCm-free); WITH_GPU=1 adds gpu-native.
RUN if [ "${WITH_GPU}" = "1" ]; then \
        export NKVX_HIPCC="${NKVX_HIPCC:-$(command -v hipcc || echo /usr/bin/hipcc)}"; \
        export HIPCC_COMPILE_FLAGS_APPEND="--offload-arch=${GPU_ARCH}"; \
        cargo build --release --features gpu-native; \
    else \
        cargo build --release; \
    fi \
    && test -x /src/clients/rkv/target/release/rkv

# ---------------------------------------------------------------------------
FROM fedora:${FEDORA_VERSION} AS runtime
ARG WITH_GPU
ARG SPDK_BASE_DIR
LABEL org.opencontainers.image.title="rados-nkv-client" \
      org.opencontainers.image.description="rkv — ergonomic Rust CLI for the NVMe-KV (rados-nkvx) datapath over vfio-user" \
      org.opencontainers.image.source="https://github.com/mmgaggle/rados-nkv"

# Runtime shared-lib deps the statically-linked rkv binary still dynamically
# needs (verified via `ldd` below): numactl-libs, libibverbs + librdmacm (SEPARATE
# packages on Fedora), json-c, libuuid, openssl-libs, lz4-libs, fuse3-libs,
# keyutils-libs.
RUN dnf install -y \
        numactl-libs libibverbs librdmacm \
        json-c libuuid openssl-libs lz4-libs fuse3-libs keyutils-libs \
    && dnf clean all

# WITH_GPU: the gpu-native binary links libamdhip64 (ROCm HIP runtime).
RUN if [ "${WITH_GPU}" = "1" ]; then dnf install -y rocm-runtime && dnf clean all; fi

# The rkv binary.
COPY --from=rkv-builder /src/clients/rkv/target/release/rkv /usr/bin/rkv

# The base SPDK was built --with-shared, so rkv links the SPDK libs DYNAMICALLY
# (libspdk_vfio_user/util/log .so) plus libvfio-user.so. Ship those shared
# objects so the dynamic link resolves at load time. (libspdk_vfio_user -> _log,
# libspdk_util -> _log; libspdk_log has no further SPDK dep — a small closure,
# but copy the whole build/lib so any transitive soname is covered.)
COPY --from=rkv-builder ${SPDK_BASE_DIR}/build/lib/libspdk_vfio_user.so* /opt/rados-nkv-libs/
COPY --from=rkv-builder ${SPDK_BASE_DIR}/build/lib/libspdk_util.so*      /opt/rados-nkv-libs/
COPY --from=rkv-builder ${SPDK_BASE_DIR}/build/lib/libspdk_log.so*       /opt/rados-nkv-libs/
COPY --from=rkv-builder ${SPDK_BASE_DIR}/build/libvfio-user/usr/local/lib/. /opt/rados-nkv-libs/
# libspdk_util pulls in isa-l (libisal.so.2 / libisal_crypto.so.2).
COPY --from=rkv-builder ${SPDK_BASE_DIR}/isa-l/.libs/libisal.so*               /opt/rados-nkv-libs/
COPY --from=rkv-builder ${SPDK_BASE_DIR}/isa-l-crypto/.libs/libisal_crypto.so* /opt/rados-nkv-libs/
RUN echo /opt/rados-nkv-libs > /etc/ld.so.conf.d/rados-nkv-rkv.conf && ldconfig \
    && ldconfig -p | grep -E 'libspdk_(vfio_user|util|log)|libvfio-user|libisal' || true

# Pin HOME so the entrypoint AND `podman exec`'d rkv calls resolve the same
# ~/.rados-nkv.conf and persistent-session daemon socket ($HOME/.rados-nkv.sock).
ENV HOME=/root

# Entrypoint launcher.
COPY packaging/container/rkv-entrypoint.sh /usr/libexec/rados-nkv/rkv-entrypoint
RUN chmod 0755 /usr/libexec/rados-nkv/rkv-entrypoint

# Verify the dynamic link is fully satisfied — fail the build on any "not found".
RUN ldd /usr/bin/rkv \
    && if ldd /usr/bin/rkv | grep -q "not found"; then \
        echo "ERROR: rkv has unresolved shared libraries:" >&2; \
        ldd /usr/bin/rkv | grep "not found" >&2; \
        exit 1; \
    fi

ENTRYPOINT ["/usr/libexec/rados-nkv/rkv-entrypoint"]
